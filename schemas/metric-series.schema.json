{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world4jason.github.io/Market-Risk-Monitor/schemas/metric-series.schema.json",
  "title": "Market Risk Monitor Metric Series",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "metric",
    "source",
    "coverage",
    "freshness",
    "lineage",
    "baselines",
    "latest",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "environment": {
      "enum": [
        "production",
        "fixture"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "pillar",
        "units",
        "frequency",
        "polarity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "pillar": {
          "enum": [
            "leverage",
            "financial_stress",
            "credit_risk",
            "volatility",
            "breadth",
            "market",
            "valuation",
            "context"
          ]
        },
        "units": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly",
            "irregular"
          ]
        },
        "polarity": {
          "enum": [
            "higher_is_riskier",
            "lower_is_riskier",
            "contextual",
            "neutral"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "dataset",
        "url"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "series_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "license_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "redistribution": {
          "enum": [
            "allowed",
            "restricted",
            "unknown",
            "derived_only"
          ]
        },
        "market_scope": {
          "type": [
            "string",
            "null"
          ],
          "description": "Market/universe scope such as NYSE when materially relevant."
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_start",
        "history_end",
        "timezone"
      ],
      "properties": {
        "history_start": {
          "type": "string",
          "format": "date"
        },
        "history_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "expected_observation_lag_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "max_age_days",
        "age_days",
        "evaluated_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "fresh",
            "stale",
            "missing",
            "error",
            "insufficient_data"
          ]
        },
        "max_age_days": {
          "type": "integer",
          "minimum": 0
        },
        "age_days": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "inputs",
        "formula",
        "transform_version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "raw",
            "derived"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "formula": {
          "type": [
            "string",
            "null"
          ]
        },
        "transform_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "point_in_time",
          "min_observations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "full_history_percentile",
              "rolling_percentile",
              "rolling_zscore",
              "rolling_robust_zscore",
              "event_window",
              "none"
            ]
          },
          "window_observations": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "min_observations": {
            "type": "integer",
            "minimum": 1
          },
          "point_in_time": {
            "type": "boolean"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "latest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "fetched_at",
        "value"
      ],
      "properties": {
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "revision_tag": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "value"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "enum": [
              "observed",
              "missing",
              "estimated",
              "revised"
            ]
          }
        }
      }
    }
  }
}
